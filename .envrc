source ./secrets.sh

# values from the credentials sheet, same key names there
export OS_DOMAIN_NAME="REPLACE_ME"     # See credentials sheet (OS_DOMAIN_NAME)
export TF_VAR_context="REPLACE_ME"     # See credentials sheet (TF_VAR_context)
export TF_VAR_email="REPLACE_ME"       # See credentials sheet (TF_VAR_email)
export TF_VAR_otc_user_id="REPLACE_ME" # See credentials sheet (TF_VAR_otc_user_id)
# The domain delegated to your project. Do not build it yourself, the workshop
# zone changes between workshops.
export TF_VAR_domain_name="REPLACE_ME" # See credentials sheet (TF_VAR_domain_name)

# replace with your own infrastructure charts ArgoCD repository
# Create a fork/template implementation of https://github.com/iits-consulting/otc-infrastructure-charts-template.git
export TF_VAR_argocd_repo_url="REPLACE_ME"

export TF_VAR_stage="dev"
export REGION="eu-de"
export TF_VAR_region=$REGION
export OS_PROJECT_NAME="${REGION}_${TF_VAR_context}" # must equal OS_PROJECT_NAME on the sheet
export CLUSTER_NAME="${TF_VAR_context}-${TF_VAR_stage}"

# Validate that all placeholders were replaced and values look sane before we
# authenticate against OTC. Aborts here instead of failing later in `tofu apply`.
if ! source ./check-setup.sh; then
  return 1
fi

# OTC auth
otc-auth login iam -o

#Terraform temp AK/SK
otc-auth temp-access-token create --duration-seconds 86390
source ./ak-sk-env.sh
export TF_VAR_ak_sk_security_token=$AWS_SESSION_TOKEN
rm ./ak-sk-env.sh

unset OS_USERNAME
unset OS_PASSWORD